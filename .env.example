# ArmorIQ Environment Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# OpenAI for embeddings
OPENAI_API_KEY=your-openai-api-key

# Vector Database
VECTOR_DB_URL=localhost:6333

# RAG Settings
RAG__EMBEDDING_MODEL=text-embedding-ada-002
RAG__CHUNK_SIZE=512
RAG__CHUNK_OVERLAP=50

# GNN Settings
GNN__MODEL_PATH=models/fraud_gnn.pt
GNN__RISK_THRESHOLD_HIGH=0.8

# Policy Settings
POLICY__BASIC_APPROVAL_LIMIT=1000.0
POLICY__DUAL_APPROVAL_THRESHOLD=10000.0
POLICY__CEO_AGENT_LIMIT=50000.0
